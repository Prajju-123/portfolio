# One file per mode (Vite loads the one that matches the mode):
#   .env.development  -> npm run dev              (local backend through the Vite proxy)
#   .env.test         -> npm run dev:test / npm run build:test
#   .env.production   -> npm run build:production / npm run build
#
# Variables (only names that start with VITE_ reach the browser):
#   VITE_APP_ENV      DEVELOPMENT | TEST | PRODUCTION
#   VITE_API_URL      where the browser sends API calls ("/api" in development, a full https URL elsewhere)
#   VITE_PROXY_TARGET dev server only: where Vite forwards "/api"
#
# Do not put secrets in these files; they are committed and visible in the browser.
